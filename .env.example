# OpenAI Realtime 语音密钥，在 OpenAI 开发者后台创建（见 README）。
OPENAI_API_KEY=
# Realtime 接口地址可指向中转或兼容服务；留空时使用官方地址
# https://api.openai.com。该服务必须实现 OpenAI Realtime 的
# /v1/realtime/calls SDP 交换协议，普通文本接口不兼容。
JARVIS_OPENAI_BASE_URL=
# 语音提供商：openai 或 doubao。
JARVIS_VOICE_PROVIDER=openai
# 可选：逗号分隔的自定义词级唤醒模型。把每个 ONNX 文件放到
# assets/wake-word/models/。内置的 hey_jarvis 模型始终启用。
# JARVIS_EXTRA_WAKE_MODELS=ashley:ashley.onnx,jarvis:jarvis.onnx
# 默认禁止自动回退。仅当豆包凭据缺失、且明确需要 OpenAI 兜底时设为 1。
JARVIS_ALLOW_VOICE_FALLBACK=0
# 豆包（火山引擎）语音凭据，在豆包语音控制台创建应用并开通所需服务（见 README）。
DOUBAO_APP_ID=
DOUBAO_API_KEY=
# 火山引擎按资源授权，资源必须指名。填写语音控制台里启用服务旁的资源 ID；
# 不填时服务端会选一个默认资源，账号可能未获授权。
DOUBAO_RESOURCE_ID=
# 仅当握手仍失败时设为 1 —— 部分产品把授权绑定到应用而非账号。
DOUBAO_SEND_APP_KEY=

# 天气凭据。
# 不填时，get_weather 会播报服务未配置。
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# 「今天天气怎么样」没有指明城市时使用的默认城市。
# macOS 上优先用设备粗略定位；Windows 上先尝试系统定位 API，失败再尝试
# IP 定位（ipwho.is）；Linux 上先尝试 IP 定位（ipwho.is），
# 失败时才回退到这里。
JARVIS_DEFAULT_CITY=

# OpenClaw 任务委派的命令行路径（可选）。默认自动检测
# ~/.npm-global/bin/openclaw、/usr/local/bin/openclaw、/usr/bin/openclaw、
# Windows 上的 %APPDATA%\npm\openclaw.cmd
# 以及 PATH 里的 openclaw；检测到才启用任务委派工具。
JARVIS_OPENCLAW_BIN=
